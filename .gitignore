node_modules/

# Secrets: ignore every .env variant, keep only the template
.env
.env.*
!.env.example

# SQLite database and its write-ahead log
data/*.db
data/*.db-wal
data/*.db-shm
!data/.gitkeep

# Web build output
web/dist/

# OS / editor noise
.DS_Store
Thumbs.db

# Local wrangler dev state (D1/KV/R2 emulation, never real data)
worker/.wrangler/

# server-judge-wasm-prototype: local test server, not deployed. The model
# files are the same ~375MB production weights already fetched by the
# browser at runtime - never committed here. Generated test-result JSON is
# a local artifact, not source.
web/scripts/server-judge-wasm-prototype/model_q4.onnx
web/scripts/server-judge-wasm-prototype/model_q4.onnx_data
web/scripts/server-judge-wasm-prototype/*.json
!web/scripts/server-judge-wasm-prototype/package.json
!web/scripts/server-judge-wasm-prototype/package-lock.json

# Local-only dev seed data for the wrangler/D1 emulator, never production
worker/seed.local.sql

# Local-only data dumps (leaderboard backups before a cleanup, etc)
*.local.json

# Benchmark score dumps - local measurement data, regenerable
web/*-scores.json
