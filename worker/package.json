{
  "name": "jacob-gg-leaderboard-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local --port 8787 --var ALLOWED_ORIGIN:http://localhost:5173",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute jacob-gg-leaderboard --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute jacob-gg-leaderboard --local --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute jacob-gg-leaderboard --local --file=migrations/0001_add_is_late.sql",
    "db:seed:local": "wrangler d1 execute jacob-gg-leaderboard --local --file=seed.local.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
